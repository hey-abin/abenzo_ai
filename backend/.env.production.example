# ==============================================================================
# Abenzo AI - Production Environment Variables Template (Render Web Service)
# DO NOT COMMIT ACTUAL SECRET VALUES TO GIT
# ==============================================================================

# Server Runtime (Automatically set by Render in production, defaults provided here)
HOST=0.0.0.0
PORT=10000
DEBUG=False

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option A: Managed Neon Serverless PostgreSQL (Recommended for Render Free tier persistence)
# When DATABASE_URL is set, Abenzo automatically uses PostgreSQL.
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-snowy-dawn-b54g9c49.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: SQLite Database Path (Note: Render Free Web Services use ephemeral disks)
DB_PATH=backend/abenzo.db

# ------------------------------------------------------------------------------
# AI Inference Configuration
# ------------------------------------------------------------------------------
# Option A: Local Ollama (Default for local development on Mac)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SECONDS=60

# Option B: Hosted OpenAI-Compatible Inference (Recommended for Render Free tier)
# Supports Groq, Together AI, OpenRouter, DeepSeek, or OpenAI
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=your_hosted_inference_api_key_here
AI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Meta Instagram Graph API & Webhook Configuration
# ------------------------------------------------------------------------------
META_VERIFY_TOKEN=your_secure_random_webhook_verify_token_here
INSTAGRAM_APP_ID=your_meta_app_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here
INSTAGRAM_ACCESS_TOKEN=your_system_user_or_page_access_token_here

# ------------------------------------------------------------------------------
# Frontend CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment domain)
CORS_ORIGINS=https://abenzo.vercel.app,http://localhost:3000
