# Backend Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# SQLite Database
DB_PATH=backend/abenzo.db
DATABASE_URL=sqlite:///./abenzo.db

# Ollama Local AI Configuration (Default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60

# Meta Instagram Integration (Optional - Keep empty until officially configured)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=abenzo_verify_token_sample
META_PAGE_ID=

# Instagram Developer App Credentials
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
